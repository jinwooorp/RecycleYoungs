# DB 연결 풀을 생성할 때 필요한 로컬 개발용 설정입니다.
# 실제 인증정보는 .env에만 보관하며 Git에 커밋하지 않습니다.
DATABASE_URL=postgresql://recycleyoungs:recycleyoungs@localhost:5432/recycleyoungs
# 풀 하나가 유지할 최대 연결 수입니다. 동시에 실행하는 ETL 수에 따라 DB 부하가 늘 수 있습니다.
DB_POOL_MAX=10
# 연결 대기 제한 시간(밀리초)입니다. SQL 실행 시간 제한과는 다릅니다.
DB_CONNECTION_TIMEOUT_MS=5000
