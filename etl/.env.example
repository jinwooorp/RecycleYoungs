# ETL 적재에 필요한 DB URL입니다. 비밀번호의 URL 예약 문자는 인코딩합니다.
DATABASE_URL=postgresql://recycleyoungs:recycleyoungs@localhost:5432/recycleyoungs

# ETL 연결 풀 최대 크기와 연결 대기 시간(ms)입니다. 양의 정수를 사용합니다.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# 상가(상권)정보 API의 Decoding 키와 서울 열린데이터광장 Open API 키입니다.
# 실제 인증키와 접속 정보는 로컬에만 보관합니다.
SEMAS_API_KEY=
SEOUL_OPEN_API_KEY=
