# Docker Compose reads .env from the project root.
# Keep the DB identity unchanged when reusing an existing postgres_data volume.
DB_NAME=startup_analysis
DB_USER=app
DB_PASSWORD=app
DB_PORT=5432

# Required only when loading commercial_areas. Confirm the source CRS first.
# The CSV contains no CRS metadata; do not choose a value from its filename.
AREA_SOURCE_CRS=
STORE_CHUNK_SIZE=50000
