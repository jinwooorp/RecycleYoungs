# 호스트 DB 접속 포트입니다.
DB_PORT=5432

# Compose의 새 DB에 필요한 이름과 계정입니다. 예시 비밀번호는 로컬 개발용입니다.
DB_NAME=recycleyoungs
DB_USER=recycleyoungs
DB_PASSWORD=recycleyoungs_local

# Compose full 프로필의 Frontend 루프백 포트입니다.
# FRONTEND_PORT=8081

# Docker에서 지도를 쓸 때 필요한 공개 JavaScript 키입니다. REST API 키와 Admin 키는 넣지 않습니다.
VITE_KAKAO_MAP_APP_KEY=

# 호스트 Backend의 db 프로필과 Flyway에 필요한 JDBC 주소입니다.
DB_JDBC_URL=jdbc:postgresql://127.0.0.1:${DB_PORT:-5432}/${DB_NAME}

# ETL 적재에 필요한 DB URL입니다. 비밀번호의 URL 예약 문자는 인코딩합니다.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:${DB_PORT:-5432}/${DB_NAME}

# ETL 연결 풀 최대 크기와 연결 대기 시간(ms)입니다. 양의 정수를 사용합니다.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# 상가(상권)정보 API의 Decoding 키와 서울 열린데이터광장 Open API 키입니다.
# 실제 인증키와 접속 정보는 로컬에만 보관합니다.
SEMAS_API_KEY=
SEOUL_OPEN_API_KEY=
