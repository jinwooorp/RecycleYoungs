# 로컬 개발용 환경변수 예시입니다. 저장소 루트의 .env로 복사해 사용합니다.
# 실제 .env와 운영용 비밀번호는 Git에 올리지 않습니다.
# Backend·ETL 실행 전에는 README의 안내대로 이 파일의 값을 셸에 내보냅니다.
# DB 이름·사용자·비밀번호는 데이터 볼륨이 처음 만들어질 때 적용됩니다.
# 이후 아래 값을 바꿔도 기존 DB의 이름·계정·비밀번호는 자동으로 변경되지 않습니다.

# 내 컴퓨터에서 DB에 접속할 포트입니다. 이미 사용 중이면 다른 포트로 변경합니다.
# 접속은 내 컴퓨터(127.0.0.1)에서만 가능하며, 컨테이너 내부 포트는 5432로 유지됩니다.
DB_PORT=5432

# 처음 실행할 때 생성할 데이터베이스 이름입니다. Backend와 ETL이 같은 이름을 사용합니다.
DB_NAME=recycleyoungs

# DB에 접속할 사용자 이름입니다. Compose가 첫 실행 시 이 계정을 생성합니다.
DB_USER=recycleyoungs

# 위 DB 사용자의 비밀번호입니다. 아래 값은 로컬 개발용 예시이며 운영 환경에 사용하지 않습니다.
# 처음 DB를 구성할 때 원하는 비밀번호로 설정하고, 실제 값은 .env에만 보관합니다.
DB_PASSWORD=recycleyoungs_local

# Spring Boot의 db 프로필에서 Flyway가 사용할 JDBC 접속 주소입니다.
# 위 포트·DB 이름을 자동으로 반영하며, 사용자와 비밀번호는 DB_USER·DB_PASSWORD에서 읽습니다.
DB_JDBC_URL=jdbc:postgresql://127.0.0.1:${DB_PORT:-5432}/${DB_NAME}

# ETL이 사용할 DB 접속 주소입니다. 위 사용자·비밀번호·포트·DB 이름을 함께 사용합니다.
# 비밀번호에 @, :, / 같은 URL 예약 문자가 있으면 이 URL의 비밀번호 부분을 URL 인코딩해 지정합니다.
# 접속 주소에 비밀번호가 포함되므로 실제 값을 로그나 공개 문서에 노출하지 않습니다.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:${DB_PORT:-5432}/${DB_NAME}

# ETL의 연결 풀 하나가 동시에 유지할 수 있는 DB 연결의 최대 개수입니다. 양수로 설정합니다.
# 크게 설정하면 DB에 부담이 늘 수 있으므로, 처음에는 기본값 10을 유지합니다.
DB_POOL_MAX=10

# ETL이 새 DB 연결을 기다리는 제한 시간입니다. 단위는 밀리초이며 5000은 5초입니다.
# 양수로 설정하며, 이 시간 안에 연결하지 못하면 오류가 발생합니다. SQL 실행 제한 시간은 아닙니다.
DB_CONNECTION_TIMEOUT_MS=5000
