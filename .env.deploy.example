# 설정·빌드 검증용 예시입니다. 기동 전 .env.deploy에 별도의 배포 DB 자격증명을 설정합니다.
DEPLOY_DB_NAME=recycleyoungs_deploy
DEPLOY_DB_USER=recycleyoungs_deploy
DEPLOY_DB_PASSWORD=example-only-change-before-start

# Nginx만 호스트의 127.0.0.1에 연결합니다. 로컬 Backend와 충돌하면 다른 포트를 지정합니다.
DEPLOY_HTTP_PORT=8080

# 브라우저 공개용 Kakao JavaScript 키입니다. 생략하면 지도 기능은 키 미설정 상태로 동작합니다.
DEPLOY_KAKAO_MAP_APP_KEY=
